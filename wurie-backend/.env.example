# WurieAI backend local environment template.
# Copy to wurie-backend/.env for local development.
# Never commit the copied .env file or real credentials.

# Firebase Admin authentication and Firestore.
# Prefer a service-account file locally; use Secret Manager on Cloud Run.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# Alternative for CI/Cloud Run only. Store the complete JSON as a secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID

# Gemini server-side model access. Never package this in the Android APK.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# LangSmith tracing and agent observability.
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=YOUR_LANGCHAIN_API_KEY
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=wurieai-development
LANGSMITH_WORKSPACE_ID=
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Render deployment hook for CI auto-deploys.
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxx?key=xxxxx

# Local-only development fallback. Keep false in production.
WURIE_DEV_AUTH_FALLBACK=false
