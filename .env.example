# Android build configuration only.
# Never put Gemini, Firebase Admin, LangSmith, signing, or service-account
# credentials in this file. The Secrets Gradle Plugin can package values into
# BuildConfig and therefore into the APK.

# Google OAuth Web client ID used by Credential Manager Google Sign-In.
# This is an OAuth client identifier, not a private API secret.
WEB_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
