# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_API_KEY2=MY_GEMINI_API_KEY
# WEB_CLIENT_ID: Required for Google Sign-In.
# Paste your actual Web Client ID here before pushing to GitHub so the GitHub Action can build it!
WEB_CLIENT_ID=457022082-ttjolttnkln871214a2jnn28gpnhrhbk.apps.googleusercontent.com
